<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Spelling Bee Round 2</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  /* Layout: school-colored header band, one focused "stage" card per word, everything else tucked away.
     --brand / --accent are set from the School colors setting at runtime. */
  :root {
    --brand: #1b2a4e; --accent: #a51c30; --ok-base: #1f7a3d; --brand-ink: #ffffff; --accent-ink: #1a1405;
    --bg: color-mix(in srgb, var(--brand) 5%, #f6f6f3);
    --surface: #ffffff;
    --fg: #182131; --muted: #5d6677; --line: #dde1e7;
    --brand-text: var(--brand);
    --ok: var(--ok-base); --ok-soft: color-mix(in srgb, var(--ok-base) 13%, #ffffff); --bad: #c2323b; --bad-soft: #fbe6e7;
    --font: 'Lexend', 'Segoe UI', system-ui, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: color-mix(in srgb, var(--brand) 12%, #0d1118); --surface: #161c26;
      --fg: #e9edf3; --muted: #9aa4b4; --line: #2a3342;
      --brand-text: color-mix(in srgb, var(--brand) 40%, #ffffff);
      --ok: color-mix(in srgb, var(--ok-base) 55%, #ffffff); --ok-soft: color-mix(in srgb, var(--ok-base) 28%, #161c26); --bad: #f0646c; --bad-soft: #3a1a1d; color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: color-mix(in srgb, var(--brand) 12%, #0d1118); --surface: #161c26;
    --fg: #e9edf3; --muted: #9aa4b4; --line: #2a3342;
    --brand-text: color-mix(in srgb, var(--brand) 40%, #ffffff);
    --ok: color-mix(in srgb, var(--ok-base) 55%, #ffffff); --ok-soft: color-mix(in srgb, var(--ok-base) 28%, #161c26); --bad: #f0646c; --bad-soft: #3a1a1d; color-scheme: dark;
  }

  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  .edit input::placeholder { text-transform: none; letter-spacing: 0; }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font); font-size: 15px; line-height: 1.5; }
  button, input, select, textarea { font: inherit; color: inherit; }
  button { cursor: pointer; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .wrap { max-width: 1040px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }

  /* Header band */
  body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--brand); }
  .top { background: var(--brand); color: var(--brand-ink); border-bottom: 4px solid var(--accent); position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; }
  .top-in { display: flex; align-items: center; gap: 16px; padding-block: 12px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 12px; margin-right: auto; min-width: 0; }
  .logo { width: 42px; height: 42px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; font-size: 22px; flex: none; }
  .school { font-weight: 700; font-size: 18px; line-height: 1.2; text-wrap: balance; }
  .sub { font-size: 12px; opacity: .8; }
  .tabs { display: flex; gap: 4px; background: rgba(0,0,0,.18); padding: 4px; border-radius: 999px; }
  .tabs button { border: 0; background: transparent; color: var(--brand-ink); padding: 7px 14px; border-radius: 999px; font-size: 14px; font-weight: 500; opacity: .85; }
  .tabs button.on { background: var(--accent); color: var(--accent-ink); opacity: 1; font-weight: 700; }
  .tabs .count { font-size: 11px; opacity: .75; margin-left: 2px; }
  .icon-btn { border: 1px solid rgba(255,255,255,.35); background: transparent; color: var(--brand-ink); width: 38px; height: 38px; border-radius: 50%; font-size: 18px; }

  main { padding-block: 20px 48px; display: grid; gap: 16px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 18px; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: end; }
  .field { display: grid; gap: 4px; flex: 1 1 180px; min-width: 0; }
  .field label, .label { font-size: 12px; font-weight: 600; color: var(--muted); letter-spacing: .03em; text-transform: uppercase; }
  input[type=text], input[type=password], select, textarea { width: 100%; border: 1px solid var(--line); background: var(--surface); border-radius: 10px; padding: 9px 12px; }
  textarea { resize: vertical; }

  .btn { border: 1px solid var(--line); background: var(--surface); border-radius: 10px; padding: 9px 14px; font-weight: 600; font-size: 14px; }
  .btn:hover { border-color: var(--brand-text); }
  .btn-brand { background: var(--brand); color: var(--brand-ink); border-color: var(--brand); }
  .btn-accent { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .btn-ok { background: var(--ok); color: #fff; border-color: var(--ok); }
  .btn-bad { background: var(--bad); color: #fff; border-color: var(--bad); }
  .btn-ghost { background: transparent; border-color: transparent; color: var(--muted); }
  .btn-ghost:hover { color: var(--fg); border-color: var(--line); }
  .btn:disabled { opacity: .45; cursor: default; }
  .btn.suggest { box-shadow: 0 0 0 3px var(--accent); }

  /* Word steps */
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .step { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 12px; border: 2px solid var(--line); background: var(--surface); font-weight: 600; font-size: 14px; text-align: left; }
  .step .dot { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; background: var(--line); color: var(--muted); flex: none; }
  .step.active { border-color: var(--brand-text); }
  .step.active .dot { background: var(--brand); color: var(--brand-ink); }
  .step.pass .dot { background: var(--ok); color: #fff; }
  .step.fail .dot { background: var(--bad); color: #fff; }
  .step small { color: var(--muted); font-weight: 400; margin-left: auto; }

  /* Stage */
  .stage { display: grid; grid-template-columns: 240px 1fr; gap: 24px; }
  .stage-left { display: grid; gap: 14px; align-content: start; }
  .btn-say { border: 0; background: var(--brand); color: var(--brand-ink); border-radius: 16px; padding: 22px 16px; font-size: 19px; font-weight: 700; display: grid; gap: 4px; justify-items: center; }
  .btn-say span { font-size: 30px; line-height: 1; }
  .btn-say small { font-size: 12px; font-weight: 400; opacity: .85; }
  .btn-start { border: 0; background: var(--ok); color: #fff; border-radius: 14px; padding: 14px; font-size: 19px; font-weight: 700; }
  .btn-start:disabled { opacity: .35; cursor: default; }
  .btn-start.pulse { animation: pulse 1.3s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent); } 50% { box-shadow: 0 0 0 10px transparent; } }
  .src { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
  .src-field { display: grid; gap: 4px; flex: 1 1 180px; min-width: 0; }
  .src-field input[type=range] { width: 100%; accent-color: var(--ok); }
  .help { font-size: 13px; padding: 12px 14px; border-radius: 12px; border: 1px solid var(--line); background: color-mix(in srgb, var(--accent) 6%, var(--surface)); }
  .help p { margin: 6px 0; } .help ol { margin: 6px 0; padding-left: 20px; display: grid; gap: 4px; }
  .tile.pop { animation: pop .18s ease-out; }
  @keyframes pop { from { transform: scale(.6); } to { transform: scale(1); } }
  .hints { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .hints .btn { font-size: 13px; padding: 8px; }
  .timer { display: flex; align-items: center; gap: 12px; }
  .ring { position: relative; width: 72px; height: 72px; flex: none; }
  .ring svg { transform: rotate(-90deg); }
  .ring .num { position: absolute; inset: 0; display: grid; place-items: center; font-weight: 800; font-size: 24px; font-variant-numeric: tabular-nums; }
  .ring circle { transition: stroke-dashoffset .3s linear, stroke .3s; }
  #timer-text { font-size: 13px; color: var(--muted); }
  .clue { font-size: 13px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 10px; min-height: 2.5em; }

  .stage-right { display: grid; gap: 14px; align-content: start; min-width: 0; }
  .mic { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px 12px; border-radius: 12px; background: color-mix(in srgb, var(--fg) 4%, transparent); }
  .mic-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--muted); flex: none; }
  .mic.on .mic-dot { background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 25%, transparent); }
  .mic.blocked .mic-dot { background: var(--bad); }
  #mic-label { font-size: 13px; font-weight: 600; }
  .meter { flex: 1 1 80px; height: 8px; border-radius: 99px; background: var(--line); overflow: hidden; min-width: 60px; }
  .meter i { display: block; height: 100%; width: 0; background: var(--ok); border-radius: 99px; transition: width .08s; }
  .mic .btn { padding: 6px 12px; font-size: 13px; }

  .letters { min-height: 76px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 12px; border: 2px dashed var(--line); border-radius: 14px; }
  .letters .empty { color: var(--muted); font-size: 14px; }
  .tile { width: 48px; height: 56px; border-radius: 10px; display: grid; place-items: center; font-size: 28px; font-weight: 800; background: color-mix(in srgb, var(--brand-text) 10%, var(--surface)); border: 2px solid var(--brand-text); color: var(--fg); }
  .tile.interim { opacity: .7; border-style: dashed; }
  .tile.unsure { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 16%, var(--surface)); }
  .heard { font-size: 12px; color: var(--muted); min-height: 1.5em; overflow-wrap: anywhere; }
  .edit { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .edit input { flex: 1 1 140px; width: auto; text-transform: uppercase; letter-spacing: .1em; }

  .verdict { display: grid; gap: 12px; padding: 14px; border-radius: 14px; border: 1px solid var(--line); }
  .verdict.match { background: var(--ok-soft); border-color: var(--ok); }
  .verdict.nomatch { background: var(--bad-soft); border-color: var(--bad); }
  .compare { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; align-items: baseline; }
  .compare b { font-size: 22px; letter-spacing: .12em; overflow-wrap: anywhere; }
  .compare .diff { color: var(--bad); text-decoration: underline; }
  .verdict-title { font-weight: 700; }

  .summary h2 { margin: 0; font-size: 22px; }
  .score-big { font-size: 40px; font-weight: 800; color: var(--brand-text); font-variant-numeric: tabular-nums; }

  /* Tables */
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); background: color-mix(in srgb, var(--fg) 3%, var(--surface)); position: sticky; top: 0; }
  tr:last-child td { border-bottom: 0; }
  .w { font-weight: 700; color: var(--brand-text); }
  .rank { width: 28px; height: 28px; border-radius: 50%; display: inline-grid; place-items: center; font-weight: 700; font-size: 13px; background: var(--line); }
  .rank.r1 { background: var(--accent); color: var(--accent-ink); }
  .tag { display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 12px; font-weight: 600; white-space: nowrap; }
  .tag.q { background: var(--ok-soft); color: var(--ok); }
  .tag.e { background: color-mix(in srgb, var(--fg) 6%, transparent); color: var(--muted); }
  .num { font-variant-numeric: tabular-nums; }

  /* Upload */
  .drop { border: 2px dashed color-mix(in srgb, var(--brand-text) 45%, var(--line)); border-radius: 16px; padding: 28px 18px; display: grid; justify-items: center; gap: 8px; text-align: center; }
  .drop.drag { background: color-mix(in srgb, var(--accent) 12%, transparent); border-color: var(--accent); }
  .drop h3 { margin: 0; font-size: 18px; }
  .drop p { margin: 0; color: var(--muted); font-size: 13px; max-width: 46ch; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .status { display: flex; align-items: center; gap: 12px; }
  .spinner { width: 18px; height: 18px; border-radius: 50%; border: 3px solid var(--line); border-top-color: var(--brand-text); animation: spin .8s linear infinite; flex: none; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .review td input, .review td textarea { padding: 6px 8px; font-size: 13px; }
  .review td textarea { min-width: 200px; }
  details summary { cursor: pointer; color: var(--brand-text); font-weight: 600; font-size: 14px; }
  .muted { color: var(--muted); font-size: 13px; }
  .head-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; justify-content: space-between; }
  .head-row h2 { margin: 0; font-size: 18px; }

  /* Settings */
  .settings { background: var(--surface); border-bottom: 1px solid var(--line); }
  .settings .wrap { padding-block: 16px; display: grid; gap: 14px; }
  .swatch { display: flex; align-items: center; gap: 8px; }
  .swatch input[type=color] { width: 44px; height: 36px; border: 1px solid var(--line); border-radius: 8px; padding: 2px; background: var(--surface); }
  .presets { display: flex; gap: 6px; flex-wrap: wrap; }
  .presets button { border: 1px solid var(--line); background: var(--surface); border-radius: 99px; padding: 4px 10px 4px 4px; font-size: 12px; display: flex; align-items: center; gap: 6px; }
  .presets i { width: 18px; height: 18px; border-radius: 50%; display: inline-block; }

  #toasts { position: fixed; z-index: 50; right: max(16px, env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); display: grid; gap: 8px; max-width: min(380px, calc(100vw - 32px)); }
  .toast { background: var(--fg); color: var(--bg); padding: 11px 14px; border-radius: 12px; font-size: 13px; font-weight: 500; box-shadow: 0 6px 24px rgba(0,0,0,.2); }
  .toast.error { background: var(--bad); color: #fff; }
  .toast.success { background: var(--ok); color: #fff; }

  @media (max-width: 720px) {
    .stage { grid-template-columns: 1fr; }
    .steps small { display: none; }
    .tile { width: 40px; height: 48px; font-size: 24px; }
    .sub { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .spinner, .btn-start.pulse, .tile.pop { animation: none; } .ring circle, .meter i { transition: none; } }
</style>

<header class="top">
  <div class="wrap top-in">
    <div class="brand">
      <div class="logo" aria-hidden="true">🐝</div>
      <div style="min-width:0">
        <div class="school" id="school-name">Spelling Bee</div>
        <div class="sub">Spelling Bee 2026–2027 · Top 3 in each class go to the Final</div>
      </div>
    </div>
    <nav class="tabs" aria-label="Sections">
      <button data-tab="arena" class="on">Compete</button>
      <button data-tab="words">Words <span class="count" id="nav-word-count"></span></button>
      <button data-tab="results">Results <span class="count" id="nav-result-count"></span></button>
    </nav>
    <button class="icon-btn" id="btn-settings" aria-label="Settings" title="Settings">⚙</button>
  </div>
</header>

<div class="settings" id="settings" hidden>
  <div class="wrap">
    <div class="row">
      <div class="field"><label for="set-school">School name</label><input type="text" id="set-school" placeholder="e.g. Al Noor International School" /></div>
      <div class="field" style="flex:0 1 160px"><label for="set-seconds">Seconds per word</label>
        <select id="set-seconds"><option value="10">10</option><option value="12">12</option><option value="15">15</option><option value="20">20</option><option value="30">30</option></select>
      </div>
      <div class="field" style="flex:1 1 260px"><label for="set-voice">Reading voice</label>
        <div class="row" style="flex-wrap:nowrap"><select id="set-voice"></select><button class="btn" id="btn-test-voice" type="button">Test</button></div>
        <span class="muted" id="voice-note" style="font-size:12px"></span>
      </div>
      <div class="field" style="flex:0 1 190px"><label for="set-lang">English</label>
        <select id="set-lang"><option value="en-US">American (Z = zee)</option><option value="en-GB">British (Z = zed)</option></select>
      </div>
      <div class="field" style="flex:0 1 140px"><label for="set-sound">Sounds</label>
        <select id="set-sound"><option value="on">On</option><option value="off">Off</option></select>
      </div>
    </div>
    <div class="row" style="align-items:center">
      <span class="label">School colors</span>
      <label class="swatch"><input type="color" id="set-brand" aria-label="Main color" /> <span class="muted">Main</span></label>
      <label class="swatch"><input type="color" id="set-accent" aria-label="Accent color" /> <span class="muted">Accent</span></label>
      <label class="swatch"><input type="color" id="set-green" aria-label="Correct color" /> <span class="muted">Correct</span></label>
      <div class="presets" id="color-presets"></div>
      <button class="btn" id="btn-close-settings" style="margin-left:auto">Done</button>
    </div>
  </div>
</div>

<main class="wrap">

  <!-- COMPETE -->
  <section id="tab-arena" style="display:grid; gap:16px">
    <div class="card row">
      <div class="field"><label for="input-student-name">Student</label><input type="text" id="input-student-name" placeholder="Student full name" /></div>
      <div class="field" style="flex:0 1 180px"><label for="select-class">Class</label><select id="select-class"></select></div>
      <div class="field" style="flex:0 1 210px"><label for="select-level">Words</label>
        <select id="select-level"><option value="mixed">One of each level</option><option value="Easy">3 Easy</option><option value="Medium">3 Medium</option><option value="Hard">3 Hard</option><option value="any">Any 3</option></select>
      </div>
      <button class="btn btn-accent" id="btn-new-round">🎲 New 3 words</button>
    </div>

    <div class="steps" id="steps">
      <button class="step" data-i="0"><span class="dot">1</span>Word 1<small></small></button>
      <button class="step" data-i="1"><span class="dot">2</span>Word 2<small></small></button>
      <button class="step" data-i="2"><span class="dot">3</span>Word 3<small></small></button>
    </div>

    <div class="card" id="no-words" hidden style="text-align:center; display:grid; gap:10px; justify-items:center; padding:32px 18px">
      <div style="font-weight:700; font-size:17px" id="no-words-text"></div>
      <div class="muted">Upload that grade's word list in the Words tab, then come back.</div>
      <button class="btn btn-brand" id="btn-go-words">Go to Words</button>
    </div>

    <div class="card stage" id="stage">
      <div class="stage-left">
        <button class="btn-say" id="btn-say"><span>🔊</span>Say the word<small id="say-sub">Word 1 of 3</small></button>
        <button class="btn-start" id="btn-start" title="Shortcut: Space">▶ Start</button>
        <div class="hints">
          <button class="btn" id="btn-def">Definition</button>
          <button class="btn" id="btn-sent">Sentence</button>
        </div>
        <div class="timer">
          <div class="ring">
            <svg width="72" height="72" viewBox="0 0 72 72" aria-hidden="true">
              <circle cx="36" cy="36" r="30" fill="none" stroke="var(--line)" stroke-width="6" />
              <circle id="ring-fill" cx="36" cy="36" r="30" fill="none" stroke="var(--ok)" stroke-width="6" stroke-linecap="round" stroke-dasharray="188.5" stroke-dashoffset="0" />
            </svg>
            <div class="num" id="timer-num">12</div>
          </div>
          <div><div style="font-weight:600">Time</div><div id="timer-text">Starts after the word is spoken</div></div>
        </div>
        <div class="clue" id="clue"></div>
      </div>

      <div class="stage-right">
        <div class="mic" id="mic-box">
          <span class="mic-dot"></span>
          <span id="mic-label">Microphone off</span>
          <div class="meter" title="Mic level"><i id="meter-fill"></i></div>
          <button class="btn" id="btn-mic">Turn on mic</button>
        </div>
        <div class="src" id="src-row" hidden>
          <label class="src-field"><span class="label">Recognizer</span><select id="engine-select"><option value="letters">Letter engine (recommended)</option><option value="browser">Browser speech (online)</option></select></label>
          <label class="src-field"><span class="label">Listen to</span><select id="src-select"><option>Turn on mic first</option></select></label>
          <label class="src-field" id="gain-wrap"><span class="label">Boost <b id="gain-val"></b></span><input type="range" id="gain" min="1" max="8" step="0.5" /></label>
          <button class="btn btn-ghost" id="btn-teams-help">Teams setup</button>
          <div class="muted" id="src-note" style="flex-basis:100%"></div>
          <div class="row" style="flex-basis:100%; align-items:center">
            <span class="muted" id="engine-note" style="flex:1"></span>
            <label class="btn" id="btn-engine-file" hidden style="cursor:pointer">Load engine file<input type="file" id="engine-file" class="sr-only" accept=".gz,.tgz,application/gzip,application/x-gzip" /></label>
          </div>
        </div>
        <div class="help" id="teams-help" hidden>
          <b>Spelling over Microsoft Teams</b>
          <p>The page has to hear the students' Teams sound, not your room.</p>
          <ol>
