    c.width = Math.round(bmp.width * s); c.height = Math.round(bmp.height * s);
    c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
    return { media_type: 'image/jpeg', data: await b64(await new Promise(r => c.toBlob(r, 'image/jpeg', .85))) };
  }
  function parseJson(t) {
    try { return JSON.parse(t); } catch (e) {}
    const f = t.match(/```(?:json)?\s*([\s\S]*?)```/); if (f) { try { return JSON.parse(f[1]); } catch (e) {} }
    const a = t.indexOf('['), b = t.lastIndexOf(']'); if (a > -1 && b > a) { try { return JSON.parse(t.slice(a, b + 1)); } catch (e) {} }
    throw { code: 'invalid_json' };
  }
  function apiClient(key) {
    return {
      json: async (prompt, opts = {}) => {
        const content = [];
        for (const im of opts.images ? Array.from(opts.images) : []) content.push({ type: 'image', source: { type: 'base64', ...(await shrink(im)) } });
        content.push({ type: 'text', text: prompt });
        let res;
        try {
          res = await fetch('https://api.anthropic.com/v1/messages', {
            method: 'POST', signal: opts.signal,
            headers: { 'content-type': 'application/json', 'x-api-key': key, 'anthropic-version': '2023-06-01', 'anthropic-dangerous-direct-browser-access': 'true' },
            body: JSON.stringify({ model: 'claude-sonnet-5-5', max_tokens: 16000, messages: [{ role: 'user', content }] })
          });
        } catch (e) { if (e.name === 'AbortError') throw { code: 'cancelled' }; throw { friendly: 'Could not reach the AI service. Check the internet connection.' }; }
        if (res.status === 401) throw { friendly: 'The API key was rejected. Check it and save again.' };
        if (res.status === 429) throw { code: 'rate_limited' };
        if (!res.ok) throw { friendly: `The AI service returned an error (${res.status}). Try again.` };
        const d = await res.json();
        return parseJson((d.content || []).filter(b => b.type === 'text').map(b => b.text).join(''));
      }
    };
  }
  function aiOff() {
    ai = null; aiImages = false;
    $('ai-note').textContent = 'AI is off here, so only TXT/CSV lists are read (one word per line).';
    $('btn-paste-ai').hidden = true;
  }
  function setupStandaloneAi() {
    $('api-key-box').hidden = false;
    const k = getKey();
    $('btn-paste-ai').hidden = !k;
    if (k) { ai = apiClient(k); aiImages = true; $('input-api-key').value = '••••••••'; $('ai-note').textContent = 'AI is on. Photos and scanned PDFs work too.'; }
    else { ai = null; aiImages = false; $('ai-note').textContent = 'Add an API key below to turn on AI. TXT/CSV lists work without it.'; }
  }
  async function setupAi() {
    if (!IN_CLAUDE) { setupStandaloneAi(); return; }
    try {
      const s = await window.claude.use('sample');
      if (!s) { aiOff(); return; }
      ai = s;
      const lim = await s.limits().catch(() => null);
      aiImages = !!lim?.images;
      $('ai-note').textContent = aiImages ? 'Or drag a file here. Photos and scanned PDFs work too.' : 'Or drag a file here.';
    } catch (e) { aiOff(); }
  }

  // ---------- Wiring ----------
  function showTab(name) {
    document.querySelectorAll('.tabs button').forEach(b => b.classList.toggle('on', b.dataset.tab === name));
    ['arena', 'words', 'results'].forEach(t => { $('tab-' + t).hidden = t !== name; });
  }

  function confirmTwice(btn, label, fn) {
    let armed = null;
    btn.addEventListener('click', () => {
      if (armed) { clearTimeout(armed); armed = null; btn.textContent = label; fn(); return; }
      btn.textContent = 'Click again to confirm';
      armed = setTimeout(() => { armed = null; btn.textContent = label; }, 3000);
    });
  }

  function boot() {
    // Classes
    const sel = $('select-class'), filt = $('filter-class');
    filt.innerHTML = '<option value="ALL">All classes</option>';
    for (const [g, secs] of Object.entries(CLASSES)) {
      const og = document.createElement('optgroup'); og.label = 'Grade ' + g;
      for (const s of secs) {
        const v = `${g}-${s}`;
        og.appendChild(new Option(`Grade ${g} - ${s}`, v));
        filt.appendChild(new Option(`Grade ${g} - ${s}`, v));
      }
      sel.appendChild(og);
    }
    sel.value = store.get('spelling_bee_last_class', '4-A');
    if (!sel.value) sel.value = '4-A';
    const grades = [...Object.keys(CLASSES), ...(words.some(w => w.grade === 'any') ? ['any'] : [])];
    for (const id of ['bank-grade', 'upload-grade']) $(id).innerHTML = grades.map(g => `<option value="${g}">${gradeLabel(g)}</option>`).join('');
    $('bank-grade').value = $('upload-grade').value = gradeOf(sel.value);
    sel.addEventListener('change', () => {
      store.set('spelling_bee_last_class', sel.value);
      $('bank-grade').value = $('upload-grade').value = gradeOf(sel.value);
      renderBank();
      if (phase === 'idle' || phase === 'marked' || !round.length) newRound();
    });

    // Color presets
    $('color-presets').innerHTML = COLOR_PRESETS.map(([n, b, a, g]) => `<button data-b="${b}" data-a="${a}" data-g="${g}"><i style="background:conic-gradient(${b} 0 120deg, ${a} 0 240deg, ${g} 0)"></i>${n}</button>`).join('');
    $('color-presets').addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; settings.brand = b.dataset.b; settings.accent = b.dataset.a; settings.green = b.dataset.g; applySettings(); });
    $('set-brand').addEventListener('input', e => { settings.brand = e.target.value; applySettings(); });
    $('set-accent').addEventListener('input', e => { settings.accent = e.target.value; applySettings(); });
    $('set-green').addEventListener('input', e => { settings.green = e.target.value; applySettings(); });
    $('set-school').addEventListener('input', e => { settings.school = e.target.value.trim(); applySettings(); });
    $('set-seconds').addEventListener('change', e => { settings.seconds = +e.target.value; applySettings(); });
    $('set-sound').addEventListener('change', e => { settings.sound = e.target.value === 'on'; applySettings(); });
    $('btn-settings').addEventListener('click', () => { $('settings').hidden = !$('settings').hidden; });
    $('btn-close-settings').addEventListener('click', () => { $('settings').hidden = true; });
    applySettings();

    document.querySelectorAll('.tabs button').forEach(b => b.addEventListener('click', () => showTab(b.dataset.tab)));

    // Compete
    $('btn-new-round').addEventListener('click', newRound);
    document.querySelectorAll('.step').forEach(el => el.addEventListener('click', () => { if (round.length && !results[+el.dataset.i]) selectWord(+el.dataset.i); }));
    $('btn-say').addEventListener('click', sayWord);
    $('btn-start').addEventListener('click', startSpelling);
    // Space = Start, Enter = Check (when not typing in a box)
    document.addEventListener('keydown', e => {
      if (e.target.closest('input, textarea, select, button') || $('tab-arena').hidden) return;
      if (e.code === 'Space') { e.preventDefault(); startSpelling(); }
      else if (e.key === 'Enter' && phase === 'listening') { e.preventDefault(); checkSpelling(); }
    });
    $('src-select').addEventListener('change', e => { const v = e.target.value; v === 'share' ? openSource('share') : openSource('mic', v.slice(4)); });
    $('gain').value = settings.gain; $('gain-val').textContent = settings.gain + '×';
    $('gain').addEventListener('input', e => {
      settings.gain = +e.target.value; $('gain-val').textContent = settings.gain + '×';
      if (gainNode) gainNode.gain.value = settings.gain;
      store.set('spelling_bee_settings_v2', settings);
    });
    $('engine-select').value = settings.engine;
    $('engine-select').addEventListener('change', e => {
      settings.engine = e.target.value; store.set('spelling_bee_settings_v2', settings);
      if (settings.engine === 'letters') { stopRecognition(); if (srcStream) loadEngine(); }
      else if (phase === 'listening') startRecognition();
      if (srcStream) fillSourceList();
      $('gain-wrap').hidden = settings.engine !== 'letters';
      renderMic();
    });
    $('engine-file').addEventListener('change', async e => {
      const f = e.target.files[0]; if (!f) return;
      vModel = null;
      const ok = await loadEngine(f);
      toast(ok ? 'Letter engine is ready.' : 'That file did not work. Choose vosk-model-small-en-us-0.15.tar.gz.', ok ? 'success' : 'error');
      e.target.value = '';
    });
    if (!IN_CLAUDE) $('src-row').hidden = false;
    $('btn-teams-help').addEventListener('click', () => { $('teams-help').hidden = !$('teams-help').hidden; });
    $('set-lang').value = settings.lang;
    $('set-lang').addEventListener('change', e => { settings.lang = e.target.value; settings.voice = ''; applySettings(); loadVoices(); });
    loadVoices();
    if ('speechSynthesis' in window) speechSynthesis.addEventListener('voiceschanged', loadVoices);
    $('set-voice').addEventListener('change', e => { settings.voice = e.target.value; store.set('spelling_bee_settings_v2', settings); });
    $('btn-test-voice').addEventListener('click', () => speak(round[active]?.word || 'spelling bee'));
    $('btn-def').addEventListener('click', () => { if (!round.length) return; $('clue').textContent = round[active].def; speakPausingMic(round[active].def, .9); });
    $('btn-sent').addEventListener('click', () => { if (!round.length) return; $('clue').textContent = round[active].sentence; speakPausingMic(round[active].sentence, .9); });
    $('btn-mic').addEventListener('click', turnOnMic);
    $('btn-undo').addEventListener('click', () => { commitSession(); committed.pop(); unsure.length = committed.length; shownCount = Math.min(shownCount, committed.length); renderLetters(); });
    $('btn-clear').addEventListener('click', resetLetters);
    $('input-type').addEventListener('keydown', e => {
      if (e.key !== 'Enter') return;
      const v = e.target.value.toUpperCase().replace(/[^A-Z]/g, '');
      if (v) { commitSession(); committed.push(...v.split('')); renderLetters(); }
      e.target.value = '';
    });
    $('btn-check').addEventListener('click', checkSpelling);
    $('btn-correct').addEventListener('click', () => mark(true));
    $('btn-wrong').addEventListener('click', () => mark(false));
    $('btn-next').addEventListener('click', nextWord);
    $('btn-next-student').addEventListener('click', () => {
      saveRound();
      toast('Saved to Results.', 'success');
      $('input-student-name').value = '';
      newRound();
      $('input-student-name').focus();
    });

    // Words
    $('file-input').addEventListener('change', e => handleFile(e.target.files[0]));
    const dz = $('drop');
    ['dragenter', 'dragover'].forEach(t => dz.addEventListener(t, e => { e.preventDefault(); dz.classList.add('drag'); }));
    ['dragleave', 'drop'].forEach(t => dz.addEventListener(t, e => { e.preventDefault(); dz.classList.remove('drag'); }));
    dz.addEventListener('drop', e => handleFile(e.dataTransfer?.files?.[0]));
    $('btn-stop').addEventListener('click', () => extractCtl?.abort());
    $('review-body').addEventListener('input', e => {
      const i = +e.target.dataset.i, f = e.target.dataset.f;
      if (!reviewItems[i] || !f) return;
      if (f === 'keep') { reviewItems[i].keep = e.target.checked; e.target.closest('tr').style.opacity = e.target.checked ? '' : '.4'; }
      else reviewItems[i][f] = e.target.value;
    });
    $('chk-all').addEventListener('change', e => { reviewItems.forEach(it => it.keep = e.target.checked); renderReview(); });
    $('btn-discard').addEventListener('click', () => { reviewItems = []; $('review').hidden = true; });
    $('btn-add').addEventListener('click', () => {
      const chosen = cleanItems(reviewItems.filter(it => it.keep));
      if (!chosen.length) { toast('No words are selected.'); return; }
      const g = $('upload-grade').value;
      const n = addWords(chosen, $('chk-replace').checked, g);
      reviewItems = []; $('review').hidden = true;
      $('bank-grade').value = g; renderBank();
      toast(`Added ${n} words.` + (chosen.length - n ? ` ${chosen.length - n} were already there.` : ''), 'success');
    });
    $('btn-paste-add').addEventListener('click', () => {
      const items = parseCSV($('paste').value);
      if (!items.length) { toast('Paste some words first.'); return; }
      toast(`Added ${addWords(items, false, $('upload-grade').value)} words to ${gradeLabel($('upload-grade').value)}.`, 'success'); $('paste').value = '';
    });
    $('btn-paste-ai').addEventListener('click', async () => {
      const text = $('paste').value.trim();
      if (!text) { toast('Paste your word list first.'); return; }
      if (!ai) { toast('AI is off here.', 'error'); return; }
      try { const items = await aiExtract({ text, name: 'pasted text' }); hideExtract(); items.length ? openReview(items, 'the pasted text') : toast('No words found.', 'error'); }
      catch (e) { hideExtract(); if (e?.code !== 'cancelled') toast(aiErrorText(e), 'error'); }
      finally { extractCtl = null; }
    });
    $('bank-grade').addEventListener('change', renderBank);
    $('btn-go-words').addEventListener('click', () => { $('upload-grade').value = $('bank-grade').value = gradeOf($('select-class').value); renderBank(); showTab('words'); });
    $('select-level').addEventListener('change', () => { if (phase === 'idle' || phase === 'marked') newRound(); });
    $('search').addEventListener('input', renderBank);
    $('bank-body').addEventListener('click', e => {
      const b = e.target.closest('[data-del]'); if (!b) return;
      words.splice(+b.dataset.del, 1); saveWords();
    });
    $('btn-export-words').addEventListener('click', () => {
      const g = $('bank-grade').value;
      exportCSV(`spelling_bee_${g === 'any' ? 'any' : 'grade' + g}_words.csv`, [['Word', 'Level', 'Definition', 'Sentence'], ...words.filter(w => String(w.grade) === g).map(w => [cell(w.word), cell(w.level), cell(w.def), cell(w.sentence)])]);
    });
    confirmTwice($('btn-clear-words'), 'Clear grade', () => { const g = $('bank-grade').value; words = words.filter(w => String(w.grade) !== g); saveWords(); });
    $('btn-save-key').addEventListener('click', () => {
      const v = $('input-api-key').value.trim();
      if (!v || v.startsWith('•')) { toast('Paste your API key first.'); return; }
      try { localStorage.setItem(KEY, v); } catch (e) { toast('This browser would not save the key.', 'error'); return; }
      setupStandaloneAi(); toast('AI is on.', 'success');
    });
    $('btn-forget-key').addEventListener('click', () => { try { localStorage.removeItem(KEY); } catch (e) {} $('input-api-key').value = ''; setupStandaloneAi(); });

    // Results
    $('filter-class').addEventListener('change', renderResults);
    $('btn-export-results').addEventListener('click', () => exportCSV('spelling_bee_results.csv', [['Student', 'Class', 'Score', 'TotalSeconds', 'Words'], ...records.map(r => [cell(r.name), cell(r.classSec), r.score, r.time, cell(r.breakdown)])]));
    confirmTwice($('btn-clear-results'), 'Reset', () => { records = []; store.set('spelling_bee_leaderboard_v2', records); renderResults(); });

    if (IN_CLAUDE) { micBlocked = true; micNote = 'The mic is blocked inside Claude. Open the downloaded page in Chrome for live mic, or type letters.'; }
    renderBank(); renderResults(); renderMic(); setupAi();
    newRound();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
</script>

